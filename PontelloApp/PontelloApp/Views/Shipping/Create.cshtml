@model PontelloApp.Models.Order

@{
	ViewData["Title"] = "Shipping Information";
    var subtotal = Model.Items.Sum(i => i.TotalPrice);

	var hasBin = !string.IsNullOrWhiteSpace(Model.Shipping?.BinOrEin);
	var tax = hasBin ? 0m : Math.Round(subtotal * 0.13m, 2);
    var total = Math.Round(subtotal + tax, 2);
}

<div class="container py-5">
	<h2 class="fw-bold mb-4">Shipping Information</h2>

	@if (TempData["SuccessMessage"] != null)
	{
		<div class="alert alert-success">@TempData["SuccessMessage"]</div>
	}

	<div class="row">
		<div class="col-md-8">
			<form asp-action="Create" asp-controller="Shipping" method="post">
				<input type="hidden" name="orderId" value="@Model.Id" />

				<div class="mb-3">
					<label class="form-label">Address</label>
					<input type="text" name="address" class="form-control" value="@Model.Shipping?.Address" required />
				</div>

                <div class="mb-3">
                    <label class="form-label">BIN / EIN (optional)</label>
                    <input type="text" name="binOrEin" class="form-control" value="@Model.Shipping?.BinOrEin" placeholder="Enter BIN or EIN if tax-exempt" />
                    <div class="form-text">If you provide a BIN or EIN, you will not be charged tax for this order.</div>
                </div>

				<div class="mb-3">
					<label class="form-label">Phone</label>
					<input type="text" name="phone" class="form-control" value="@Model.Shipping?.Phone" required />
				</div>

				<div class="mb-3">
					<label class="form-label">Email</label>
					<input type="email" name="email" class="form-control" value="@Model.Shipping?.Email" required />
				</div>

				<button type="submit" class="btn btn-dark">Confirm</button>
			</form>
		</div>

		<div class="col-md-4">
			<div class="card p-3 shadow-sm">
				<h5 class="fw-bold mb-3">Order Summary</h5>
				<div class="d-flex justify-content-between mb-2">
					<span>Items:</span>
					<span>@Model.Items.Sum(i => i.Quantity)</span>
				</div>
				<div class="d-flex justify-content-between mb-2">
					<span>Subtotal:</span>
					<span>$@subtotal</span>
				</div>
				<div class="d-flex justify-content-between mb-2">
					<span>Tax (13%):</span>
					<span>$@tax</span>
				</div>
				<hr />
				<div class="d-flex justify-content-between fw-bold fs-5">
					<span>Total:</span>
					<span>$@total</span>
				</div>
				@if(hasBin)
				{
					<div class="mt-2 text-success small">BIN/EIN provided — tax exempt</div>
				}
			</div>
		</div>
	</div>
</div>
