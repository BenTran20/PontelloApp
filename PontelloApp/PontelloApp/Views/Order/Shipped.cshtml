@model PontelloApp.Models.Order

@{
    ViewData["Title"] = "Review Order";
}

<div class="container py-4">

    <!-- HEADER -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold mb-1">Review Order</h2>
            <div class="text-muted small">
                PO#: <strong>@Model.PONumber</strong>
                • Created: @Model.CreatedAt.ToString("f")
            </div>
        </div>

        <div class="d-flex gap-2">
            <a asp-action="ExportOrderPO"
               asp-route-id="@Model.Id"
               class="btn btn-outline-secondary">
                Download PO
            </a>
        </div>
    </div>


    <div class="row g-4">

        <!-- LEFT SIDE : ORDER ITEMS -->
        <div class="col-lg-8">

            <div class="card shadow-sm border-0">
                <div class="card-header bg-white fw-semibold">
                    Order Items
                </div>

                <div class="card-body p-0">

                    <table class="table table-hover align-middle mb-0">

                        <thead class="table-light">
                            <tr>
                                <th>Product</th>
                                <th>Variant</th>
                                <th>Unit Price</th>
                                <th>Qty</th>
                                <th class="text-end">Total</th>
                            </tr>
                        </thead>

                        <tbody>

                            @foreach (var item in Model.Items)
                            {
                                <tr>

                                    <td class="fw-semibold">
                                        @item.Product?.ProductName
                                    </td>

                                    <td class="text-muted small">
                                        @if (item.ProductVariant != null && item.ProductVariant.Options.Any())
                                        {
                                            @string.Join(" • ",
                                            item.ProductVariant.Options.Select(o => $"{o.Name}: {o.Value}"))
                                                                        }
                                        else
                                        {
                                            <span class="text-muted">—</span>
                                        }
                                    </td>

                                    <td>$@item.UnitPrice</td>

                                    <td>@item.Quantity</td>

                                    <td class="text-end fw-semibold">
                                        $@item.TotalPrice
                                    </td>

                                </tr>
                            }

                        </tbody>

                    </table>

                </div>
            </div>

        </div>


        <!-- RIGHT SIDE : ORDER SUMMARY -->
        <div class="col-lg-4">

            <div class="card shadow-sm border-0 sticky-top" style="top:100px;">

                <div class="card-header bg-white fw-semibold">
                    Order Summary
                </div>

                <div class="card-body">

                    <div class="d-flex justify-content-between mb-2">
                        <span>Subtotal</span>
                        <span>$@Model.Items.Sum(i => i.TotalPrice)</span>
                    </div>

                    <div class="d-flex justify-content-between mb-2">
                        <span>Tax (13%)</span>
                        <span>$@Model.TaxAmount</span>
                    </div>

                    <hr />

                    <div class="d-flex justify-content-between fw-bold fs-5 mb-4">
                        <span>Total</span>
                        <span>$@Model.TotalAmount</span>
                    </div>


                    <!-- SHIPPING -->
                    @if (Model.Shipping != null)
                    {
                        <div class="bg-light rounded p-3 mb-4 small">

                            <div class="fw-semibold mb-2">
                                Shipping Information
                            </div>

                            <div>@Model.Shipping.FullName</div>
                            <div class="text-muted">@Model.Shipping.Address</div>
                            <div class="text-muted">Phone: @Model.Shipping.Phone</div>
                            <div class="text-muted">Email: @Model.Shipping.Email</div>

                            @if (!string.IsNullOrWhiteSpace(Model.Shipping.BinOrEin))
                            {
                                <div class="text-muted mt-2">
                                    BIN / EIN: @Model.Shipping.BinOrEin
                                </div>
                            }

                            @if (!string.IsNullOrWhiteSpace(Model.Shipping.TrackingNumber))
                            {
                                <div class="text-muted mt-2">
                                    Tracking: @Model.Shipping.TrackingNumber
                                </div>
                            }

                        </div>
                    }


                    <form asp-action="Decision" asp-route-id="@Model.Id" method="post">
                        <button type="submit"
                                name="status"
                                value="Shipped"
                                class="btn btn-success w-100 py-3 rounded-pill">
                            Ship
                        </button>
                    </form>

                </div>

            </div>

        </div>

    </div>

</div>
