@using PontelloApp.Models
@model IEnumerable<PontelloApp.Models.Order>

@{
    ViewData["Title"] = "My Orders";
}
<div class="container-fluid mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h3 class="m-0">Order History</h3>
        <span class="text-muted small">
            @ViewData["TotalItems"] orders
        </span>
    </div>

    <div class="card shadow-sm p-4 mb-4">
        <form method="get">
                <div class="row g-3 align-items-end">

                    <!-- FROM -->
                    <div class="col-md-2">
                        <label class="form-label small text-muted">FROM DATE</label>
                        <input type="date"
                               name="FromDate"
                               value="@Context.Request.Query["FromDate"]"
                               class="form-control" />
                    </div>

                    <!-- TO -->
                    <div class="col-md-2">
                        <label class="form-label small text-muted">TO DATE</label>
                        <input type="date"
                               name="ToDate"
                               value="@Context.Request.Query["ToDate"]"
                               class="form-control" />
                    </div>

                    <!-- STATUS -->
                    <div class="col-md-2">
                        <label for="OrderStatusID" class="form-label small text-muted">STATUS</label>
                        @Html.DropDownList("Status", (SelectList)ViewData["OrderStatusID"], "All", new { @class = "form-select" })
                    </div>

                    <!-- SEARCH -->
                    <div class="col-md-3">
                        <label for="SearchString" class="form-label small text-muted">PO</label>
                        <div class="input-group">
                            @Html.TextBox("SearchString", null, new { @class = "form-control", placeholder = "#" })
                            <button class="btn btn-outline-secondary" type="submit">
                                <em class="bi bi-search" aria-hidden="true"></em>
                                <span class="visually-hidden">Search</span>
                            </button>
                        </div>
                    </div>

                    <!-- BUTTONS -->
                    <div class="col-md-3 d-flex gap-2">
                        <a asp-action="Index"
                           class="btn btn-outline-dark w-50">
                            Clear
                        </a>

                        <button type="submit"
                                class="btn btn-blue w-50">
                            Apply
                        </button>
                    </div>

                </div>
        </form>
    </div>
    
    <div class="card shadow-sm p-4">

        <table class="table table-hover align-middle mb-0">

            <thead class="table-light">
                <tr>
                    <th style="width:10%">ID</th>
                    <th style="width:20%">PO</th>
                    <th style="width:15%">Date</th>
                    <th style="width:13%">Total</th>
                    <th style="width:15%">Status</th>
                    <th style="width:25%">Email</th>
                    <th class="text-end" style="width:20%">Actions</th>
                </tr>
            </thead>

            <tbody>
                @foreach (var o in Model)
                {
                    string badge = o.Status switch
                    {
                        OrderStatus.Draft => "bg-secondary",
                        OrderStatus.Submitted => "bg-warning text-dark",
                        OrderStatus.Approved => "bg-success",
                        OrderStatus.Rejected => "bg-danger",
                        OrderStatus.Shipped => "bg-primary",
                        _ => "bg-dark"
                    };

                    <tr>
                        <td>@o.Id</td>

                        <td>
                            <strong>@o.PONumber</strong>
                        </td>

                        <td>
                            @o.CreatedAt.ToString("MMM dd, yyyy")
                        </td>

                        <td>
                            $@o.TotalAmount.ToString("N2")
                        </td>

                        <td>
                            <span class="badge @badge">
                                @o.Status
                            </span>
                        </td>

                        <td>
                            @o.Shipping.Email
                        </td>

                        <td class="text-end">
                            <div class="btn-group btn-group-sm">

                                <a asp-action="Details"
                                   asp-route-id="@o.Id"
                                   class="btn btn-secondary">
                                    View
                                </a>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>

        </table>
    </div>

</div>

