@model PontelloApp.Models.Product

<div class="container py-5">

    <!-- SUCCESS MESSAGE -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show shadow-sm" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i>
            @TempData["SuccessMessage"]

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert">
            </button>
        </div>
    }

    <div class="row g-5">

        <!-- PRODUCT INFORMATION -->
        <div class="col-lg-7">

            <h2 class="fw-bold mb-3">
                @Model.ProductName
            </h2>

            <div class="text-muted mb-4">
                @Html.Raw(Model.Description)
            </div>

            <div class="card border-0 shadow-sm">
                <div class="card-body">

                    <h6 class="fw-bold mb-3 text-muted text-uppercase small">
                        Product Details
                    </h6>

                    <div class="row mb-2">
                        <div class="col-4 text-muted">Vendor</div>
                        <div class="col-8 fw-semibold">@Model.Vendor</div>
                    </div>

                    <div class="row mb-2">
                        <div class="col-4 text-muted">Handle</div>
                        <div class="col-8">@Model.Handle</div>
                    </div>

                    <div class="row mb-2">
                        <div class="col-4 text-muted">Category</div>
                        <div class="col-8">
                            @Model.Category?.FullCategory
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-4 text-muted">Type</div>
                        <div class="col-8">@Model.Type</div>
                    </div>

                </div>
            </div>

        </div>


        <!-- PURCHASE CARD -->
        <div class="col-lg-5">

            <div class="card shadow rounded-2 border-0 sticky-top" style="top:100px;">

                <div class="card-body p-4">

                    <h5 class="fw-bold mb-4">
                        <i class="bi bi-bag me-2"></i>
                        Buy Product
                    </h5>

                    <form asp-action="AddToCart" method="post">

                        <input type="hidden"
                               name="productId"
                               value="@Model.ID" />

                        <!-- VARIANT -->
                        <div class="mb-4">

                            <label class="form-label fw-semibold">
                                Choose Variant
                            </label>

                            <select name="variantId"
                                    class="form-select"
                                    required>

                                <option value="">
                                    Select a variant
                                </option>

                                @foreach (var v in Model.Variants ?? Enumerable.Empty<PontelloApp.Models.ProductVariant>())
                                {
                                    <option value="@v.Id">
                                        @string.Join(" • ", v.Options.Select(o => $"{o.Name}: {o.Value}"))
                                        — @v.UnitPrice.ToString("C")
                                    </option>
                                }

                            </select>

                        </div>

                        <!-- QUANTITY -->
                        <div class="mb-4">

                            <label class="form-label fw-semibold">
                                Quantity
                            </label>

                            <input type="number"
                                   name="quantity"
                                   value="1"
                                   min="1"
                                   class="form-control" />

                        </div>

                        <!-- ADD TO CART -->
                        <button type="submit"
                                class="btn btn-primary w-100 py-3 fw-semibold">

                            <i class="bi bi-cart-plus me-2"></i>
                            Add to Cart

                        </button>

                    </form>

                </div>

            </div>

        </div>

    </div>

</div>
